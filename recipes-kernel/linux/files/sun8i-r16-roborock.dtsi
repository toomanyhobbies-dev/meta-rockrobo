// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Roborock "Ruby-R16" main board, shared by the S5 (S502-00) and the Gen 1 (Xiaomi Mi Robot Vacuum / Roborock V1):
 * Allwinner R16, 512 MB DDR3, 8-bit eMMC, RTL8189ES SDIO Wi-Fi, AXP223 PMIC. Booted by the stock U-Boot.
 *
 * uart0 PF2/PF4  debug console
 * uart1 PG6/PG7  LDS (lidar)
 * uart2 PB0/PB1  chassis MCU, 1152000 8N1
 * mmc1  PG0-PG5  RTL8189ES SDIO, shutdown PL6
 * mmc2  PC5-PC16 eMMC, 8-bit
 * PH9   speaker amplifier enable, fed from the codec's headphone output
 *
 * AXP223 PMIC on RSB, rails as stock runs them; the S5's Wi-Fi also needs DLDO2 (sun8i-r16-roborock-s5.dts).
 */

#include "sun8i-a33.dtsi"

#include <dt-bindings/clock/sun6i-rtc.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	aliases {
		/* the bootloader passes root=/dev/mmcblk0p8 or p9 */
		mmc0 = &mmc2;
		mmc1 = &mmc1;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* the bootloader adds no memory node to the appended DTB */
	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x20000000>;
	};

	reg_vcc_io: regulator-vcc-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc-io";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
	};

	/* [audio0] audio_pa_ctrl */
	speaker_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&pio 7 9 GPIO_ACTIVE_HIGH>;	/* PH9 */
		sound-name-prefix = "Speaker Amp";
	};

	/* RTL8189ES 32 kHz clock: claimed so it is not gated off as unused */
	wifi_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 0 6 GPIO_ACTIVE_LOW>;	/* PL6, [wifi_para] rtl8189es_shdn */
		clocks = <&rtc CLK_OSC32K_FANOUT>;
		clock-names = "ext_clock";
	};
};

/* SID efuses: read directly, as on the A10 */
&{/soc} {
	sid: eeprom@1c23800 {
		compatible = "allwinner,sun4i-a10-sid";
		reg = <0x01c23800 0x10>;
	};
};

&pio {
	uart2_pb_pins: uart2-pb-pins {
		pins = "PB0", "PB1";
		function = "uart2";
	};

	/* mmc2_8bit_pins at the stock 40 mA drive strength */
	mmc2_8bit_40ma_pins: mmc2-8bit-40ma-pins {
		pins = "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC12", "PC13", "PC14", "PC15", "PC16";
		function = "mmc2";
		drive-strength = <40>;
		bias-pull-up;
	};
};

&codec {
	status = "okay";
};

&dai {
	status = "okay";
};

/*
 * Rails stock runs enabled are always-on without voltage constraints, except the CPU's; the rest are deleted, so the
 * regulator core neither changes them nor switches them off as unused.
 */
&r_rsb {
	status = "okay";

	axp22x: pmic@3a3 {
		compatible = "x-powers,axp223";
		reg = <0x3a3>;
		interrupt-parent = <&r_intc>;
		interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_LOW>;
	};
};

#include "axp22x.dtsi"

/* enabled under stock */
&reg_dcdc1 { regulator-always-on; };
&reg_dcdc2 { regulator-always-on; };
&reg_dcdc3 {
	regulator-always-on;
	regulator-min-microvolt = <1140000>;
	regulator-max-microvolt = <1360000>;
	regulator-name = "vdd-cpu";
};
&reg_dcdc4 { regulator-always-on; };
&reg_dcdc5 { regulator-always-on; };
&reg_dc5ldo { regulator-always-on; };
&reg_aldo1 { regulator-always-on; };
&reg_aldo2 { regulator-always-on; };
&reg_aldo3 { regulator-always-on; };

/* disabled under stock */
/delete-node/ &reg_dc1sw;
/delete-node/ &reg_dldo3;
/delete-node/ &reg_dldo4;
/delete-node/ &reg_eldo1;
/delete-node/ &reg_eldo2;
/delete-node/ &reg_eldo3;

/* Wi-Fi rail, off at boot */
&reg_dldo1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi";
};

&cpu0 {
	cpu-supply = <&reg_dcdc3>;
};

/* stock [dvfs_table]: 648 MHz to 1.2 GHz at its voltages */
&cpu0_opp_table {
	/delete-node/ opp-120000000;
	/delete-node/ opp-240000000;
	/delete-node/ opp-312000000;
	/delete-node/ opp-408000000;
	/delete-node/ opp-480000000;
	/delete-node/ opp-504000000;
	/delete-node/ opp-600000000;
	/delete-node/ opp-720000000;
	/delete-node/ opp-912000000;

	opp-648000000 {
		opp-microvolt = <1140000>;
	};

	opp-816000000 {
		opp-microvolt = <1140000>;
	};

	opp-1008000000 {
		opp-microvolt = <1240000>;
	};

	opp-1200000000 {
		opp-hz = /bits/ 64 <1200000000>;
		opp-microvolt = <1360000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};
};

&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pg_pins>;
	vmmc-supply = <&reg_vcc_io>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	status = "okay";
};

/* eMMC: 8-bit DDR52 at 50 MHz with zero clock phase, as the stock kernel runs it */
&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_40ma_pins>;
	vmmc-supply = <&reg_vcc_io>;
	rockrobo,zero-clk-phase;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	status = "okay";
};

/* APB2 (UARTs) from pll-periph at 37.5 MHz, as stock: needed for the MCU's 1152000 baud. 22 = APB2, 10 = PLL_PERIPH */
&ccu {
	assigned-clocks = <&ccu 22>;
	assigned-clock-parents = <&ccu 10>;
	assigned-clock-rates = <37500000>;
};

/* speaker amplifier on the headphone output, HPCOM as its reference ([audio0] headphone_direct_used) */
&sound {
	simple-audio-card,aux-devs = <&codec_analog>, <&speaker_amp>;
	simple-audio-card,widgets = "Speaker", "Speaker";
	simple-audio-card,routing =
		"Left DAC", "DACL",
		"Right DAC", "DACR",
		"HP", "HPCOM",
		"Speaker Amp INL", "HP",
		"Speaker Amp INR", "HP",
		"Speaker", "Speaker Amp OUTL",
		"Speaker", "Speaker Amp OUTR";
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pf_pins>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pg_pins>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pb_pins>;
	status = "okay";
};
