// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/* Roborock S5 (S502-00). Board details and test-boot policy: sun8i-r16-roborock.dtsi */

/dts-v1/;
#include "sun8i-r16-roborock.dtsi"

/ {
	model = "Roborock S5 (S502-00)";
	compatible = "roborock,s5", "allwinner,sun8i-r16", "allwinner,sun8i-a33";
};

/*
 * The S5's RTL8189ES needs two PMIC rails (stock sys_config [wifi_para]: wifi_power = axp22_dldo1,
 * wifi_power_ext1 = axp22_dldo2; the stock kernel logs "[rtl8189es]: module power ext1 name axp22_dldo2" and runs
 * both at 3.3 V). The Gen 1 only uses DLDO1, which the bootloader leaves on; on the S5 nothing switches DLDO2 on
 * unless Linux knows about the PMIC. Without it: "sunxi-mmc 1c10000.mmc: fatal err update clk timeout", no card.
 *
 * Keep the dtsi's rule (Linux leaves rails where the bootloader put them) for everything else: only the two Wi-Fi
 * rails get constraints. The regulator core cannot change or switch off a regulator without constraints, so every
 * other AXP223 output stays untouched. Do NOT pin the others to the stock kernel's runtime values: those include
 * cpufreq-scaled ones (DCDC3 reads 1.14 V under stock, the bootloader sets 1.24 V), and mainline doesn't scale
 * the CPU clock. Bus/address as on the other R16 boards (sun8i-r16-bananapi-m2m.dts): AXP223 is the RSB variant.
 */
&r_rsb {
	status = "okay";

	axp22x: pmic@3a3 {
		compatible = "x-powers,axp223";
		reg = <0x3a3>;
		interrupt-parent = <&r_intc>;
		interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_LOW>;
		/*
		 * The regulator driver writes the shared DC-DC switching-frequency register at probe even for rails it
		 * otherwise leaves alone. The bootloader left it at 3000 kHz (reg 0x37 = 0x08 = 1800 + 8*150), read from
		 * the live PMIC on a diagnostic boot, and that is also the driver default for the AXP223 -- pin it so the
		 * CPU/DRAM rails' frequency can never shift from the stock value.
		 */
		x-powers,dcdc-freq = <3000>;
	};
};

#include "axp22x.dtsi"

/*
 * Both Wi-Fi rails are OFF at 0.7 V out of the bootloader on the S5 (diagnostic boot read PWR_OUT_CTRL2 reg 0x12 = 0,
 * DLDO1/DLDO2 voltage regs 0x15/0x16 = 0; unlike the Gen 1, where DLDO1 is already on). The stock kernel's Wi-Fi
 * driver brings both up at 3.3 V. Constrain only these two; every other AXP223 rail has no constraints, so the
 * regulator core cannot change or disable it, and it stays exactly where the bootloader put it.
 */
&reg_dldo1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi";
};

&reg_dldo2 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi-ext";
};
