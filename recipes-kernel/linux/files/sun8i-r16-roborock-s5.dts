/* Roborock S5 (S502-00). Board details and test-boot policy: sun8i-r16-roborock.dtsi */

/dts-v1/;
#include "sun8i-r16-roborock.dtsi"

#include <dt-bindings/pwm/pwm.h>

/ {
	model = "Roborock S5 (S502-00)";
	compatible = "roborock,s5", "allwinner,sun8i-r16", "allwinner,sun8i-a33";

	/* lidar motor, [lds_para] and [pwm0_para] in the stock FEX */
	lds-motor {
		compatible = "roborock,lds-motor";
		pinctrl-names = "default";
		pinctrl-0 = <&pwm0_pin>;
		pwms = <&pwm 0 50000 PWM_POLARITY_INVERTED>;
		mode-gpios = <&r_pio 0 5 GPIO_ACTIVE_HIGH>,	/* PL5 */
			     <&r_pio 0 4 GPIO_ACTIVE_HIGH>;	/* PL4 */
		interrupts-extended = <&r_pio 0 9 IRQ_TYPE_EDGE_FALLING>;	/* PL9, lds_int */
	};
};

&pwm {
	status = "okay";
};

/*
 * The S5's RTL8189ES also needs DLDO2, which only the stock Wi-Fi driver switches on, so the AXP223 is described.
 * Rails stock runs enabled are always-on without voltage constraints; the rest are deleted, so the regulator core
 * neither changes them nor switches them off as unused.
 */
&r_rsb {
	status = "okay";

	axp22x: pmic@3a3 {
		compatible = "x-powers,axp223";
		reg = <0x3a3>;
		interrupt-parent = <&r_intc>;
		interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_LOW>;
		/* written at probe; keep the bootloader value */
		x-powers,dcdc-freq = <3000>;
	};
};

#include "axp22x.dtsi"

/* enabled under stock */
&reg_dcdc1 { regulator-always-on; };
&reg_dcdc2 { regulator-always-on; };
&reg_dcdc3 { regulator-always-on; };
&reg_dcdc4 { regulator-always-on; };
&reg_dcdc5 { regulator-always-on; };
&reg_dc5ldo { regulator-always-on; };
&reg_aldo1 { regulator-always-on; };
&reg_aldo2 { regulator-always-on; };
&reg_aldo3 { regulator-always-on; };

/* disabled under stock */
/delete-node/ &reg_dc1sw;
/delete-node/ &reg_dldo3;
/delete-node/ &reg_dldo4;
/delete-node/ &reg_eldo1;
/delete-node/ &reg_eldo2;
/delete-node/ &reg_eldo3;

/* Wi-Fi rails, off at boot */
&reg_dldo1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi";
};

&reg_dldo2 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi-ext";
};
