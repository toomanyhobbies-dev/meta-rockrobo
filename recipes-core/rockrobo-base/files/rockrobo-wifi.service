[Unit]
Description=rockrobo Wi-Fi: wpa_supplicant on wlan0 (reuses the stock /mnt/data/wlan config in place)
# The stock config lives on the shared data partition, so both slots use the same credentials with nothing copied.
After=mnt-data.mount
Requires=mnt-data.mount
Before=network.target
Wants=network.target

[Service]
Type=simple
# The RTL8189ES module autoloads, but wlan0 registers a moment after the SDIO function is probed -- wait for it.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 40); do [ -e /sys/class/net/wlan0 ] && exit 0; sleep 0.25; done; echo "wlan0 never appeared"; exit 1'
ExecStart=/usr/sbin/wpa_supplicant -i wlan0 -D nl80211 -c /mnt/data/wlan/wpa_supplicant.conf -C /run/wpa_supplicant
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
