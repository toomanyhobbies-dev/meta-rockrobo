# The stock data partition (UDISK = mmcblk0p1) holding persistent state. nofail so boot still succeeds if it is
# absent or unformatted; 'auto' tolerates ext4/vfat.
[Unit]
Description=Robot data partition (/mnt/data)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target

[Mount]
What=/dev/mmcblk0p1
Where=/mnt/data
Type=auto
Options=nofail,noatime

[Install]
WantedBy=local-fs.target
