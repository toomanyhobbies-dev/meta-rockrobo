# The stock data partition (UDISK = mmcblk0p1) holding persistent state; 'auto' tolerates ext4/vfat. nofail keeps
# boot moving; without it the slot falls back (dustcrawler-data-fail, dustcrawler-data-guard).
[Unit]
Description=Robot data partition (/mnt/data)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target
OnFailure=dustcrawler-data-fail.service

[Mount]
What=/dev/mmcblk0p1
Where=/mnt/data
Type=auto
Options=nofail,noatime

[Install]
WantedBy=local-fs.target
