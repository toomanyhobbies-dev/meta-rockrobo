[Unit]
Description=Chassis-MCU heartbeat (keeps the MCU from resetting or power-keying the board)
DefaultDependencies=no
After=dev-ttyS2.device
BindsTo=dev-ttyS2.device
Conflicts=shutdown.target
Before=shutdown.target
# rockrobo-hal heartbeats the same link when it is installed
ConditionPathExists=!/usr/bin/rockrobo-hal

[Service]
ExecStart=/usr/sbin/rockrobo-mcu-heartbeat /dev/ttyS2
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
